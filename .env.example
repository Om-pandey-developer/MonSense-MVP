# MonSense Environment Variables
# Copy this file to .env and fill in the values

# App
APP_NAME=MonSense
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=change-this-to-a-secure-random-key

# Database
DATABASE_URL=postgresql+asyncpg://monsense:monsense@localhost:5432/monsense_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Alert Services (optional — leave blank for demo mode)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
GUPSHUP_API_KEY=
GUPSHUP_APP_NAME=

# External Data (optional)
CDS_API_KEY=
